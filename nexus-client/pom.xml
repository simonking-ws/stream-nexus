<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 编译完全交给父 POM（spring-boot-starter-parent -> stream-nexus）：
         插件版本、Java 目标版本、依赖版本都不在本模块里另写一套 -->
    <parent>
        <groupId>com.simonking.stream</groupId>
        <artifactId>stream-nexus</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.simonking.nexus</groupId>
    <artifactId>nexus-client</artifactId>
    <version>1.0.0</version>
    <name>nexus-client</name>
    <description>
        nexus 推送的客户端 SDK：REST（NexusRestClient，okhttp，ssePush 推 SSE 服务 / wsPush 推 WebSocket 服务，
        同步拿回执）、TCP 长连接（NexusTcpClient，高频、发后不管）。builder 拼参数后直接推，
        由服务端扇出到终端，无需编写 SSE / WebSocket 服务端代码。
        名字不带 websocket 是因为它同时对接 SSE 与 WebSocket 两个推送服务。
    </description>

    <properties>
        <!-- 唯一一处覆盖父 POM 的编译属性：这是给别的业务系统引入的 SDK，
             按 Java 8 出包老系统才能直接用（代码也一直按 Java 8 语法写）。
             想跟随父 POM 用 17，删掉这一行即可 -->
        <java.version>8</java.version>
    </properties>

    <dependencies>
        <!-- 版本均由父 POM（spring-boot-starter-parent 的 dependencyManagement + 本项目）统一管理 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- REST 推送通道（NexusRestClient）：一次 HTTP POST 拿到回执 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.simonking.stream</groupId>
            <artifactId>nexus-common</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- 本模块是对外 SDK，不是可执行 jar；跳过继承自父 POM 的 repackage -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
