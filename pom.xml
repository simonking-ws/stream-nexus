<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.simonking.stream</groupId>
    <artifactId>stream-nexus</artifactId>
    <version>1.0.0</version>
    <name>stream-nexus</name>
    <description>stream-nexus</description>
    <packaging>pom</packaging>

    <modules>
        <module>nexus-common</module>
        <module>nexus-sse</module>
        <module>nexus-websocket</module>
        <!-- 独立客户端 SDK：不继承本父 POM、不依赖任何 nexus-* 模块，仅在此聚合构建 -->
        <module>nexus-websocket-client</module>
    </modules>

    <properties>
        <nexus-common.version>1.0.0</nexus-common.version>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.simonking.stream</groupId>
                <artifactId>nexus-common</artifactId>
                <version>${nexus-common.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
